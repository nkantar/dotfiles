theme = "onedark"

[editor]
scrolloff = 10
line-number = "relative"
cursorline = true
cursorcolumn = true
# rulers = [57,72,100]
# bufferline = "multiple"
end-of-line-diagnostics = "hint"

bufferline = "multiple"
{{- if eq .chezmoi.os "darwin" }}

clipboard-provider = "pasteboard"
{{- end }}

[editor.soft-wrap]
enable = true

[keys.normal.space.n]
"w" = ":w"
"r" = ":reload-all"
